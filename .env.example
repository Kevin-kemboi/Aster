# No secrets are required for the local demo.
NODE_ENV=development
PORT=4173

# Optional normalized university catalogue feed.
# The app shows no live results until this HTTPS feed returns the reviewed
# structure documented in docs/LIVE-DATA-SETUP.md.
ASTERPATH_CATALOGUE_FEED_URL=
ASTERPATH_CATALOGUE_FEED_TOKEN=
ASTERPATH_CATALOGUE_FEED_HOSTS=
CATALOGUE_REFRESH_MS=900000

# Future production integrations (not connected in this preview):
# DATABASE_URL=
# DATABASE_MIGRATION_URL=
# SESSION_SECRET=
# EMAIL_PROVIDER_API_KEY=
# OBJECT_STORAGE_BUCKET=
# FX_RATE_PROVIDER_KEY=
